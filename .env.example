# Vercel deployment env vars -- see deployment-vercel.md.
# Local dev: copy to .env and run `vercel dev`, which reads this file automatically.
# Production/preview: set these via `vercel env add <name>` or the Vercel dashboard, NOT by
# committing a real .env file (it's gitignored on purpose -- see .gitignore).

# Azure Storage (Blob for files, Table for job records) -- still an Azure resource even when the
# compute layer is Vercel; only the LLM and hosting moved off Azure.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net

# Azure AI Document Intelligence
DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-doc-intelligence-resource>.cognitiveservices.azure.com/
DOCUMENT_INTELLIGENCE_KEY=<key>

# Claude (Anthropic) -- console.anthropic.com
CLAUDE_API_KEY=<your Anthropic API key>
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=4096

# Shared-secret gate this app enforces itself since Vercel has no AuthLevel.FUNCTION equivalent
# (see app.py's module docstring). Generate with: openssl rand -hex 32
API_ACCESS_KEY=<a long random string -- required, requests 500 without it>

# Optional: restrict CORS to your actual frontend origin instead of the "*" POC default.
CORS_ALLOWED_ORIGIN=https://your-frontend.vercel.app

TARGET_DPI=300
MIN_DPI=200
MAX_PAGES=10
